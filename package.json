{
  "name": "lumasync",
  "private": true,
  "version": "1.5.5-rc.5",
  "description": "Native desktop app that mirrors your screen to WS2812B LED strips and Philips Hue entertainment areas in real time — per-edge room-map calibration, fully local processing.",
  "homepage": "https://lumasync.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/voyvodka/LumaSync.git"
  },
  "bugs": {
    "url": "https://github.com/voyvodka/LumaSync/issues"
  },
  "license": "MIT",
  "author": "voyvodka",
  "packageManager": "bun@1.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "test": "vitest run",
    "lint": "bun run typecheck",
    "check:rust": "cargo check --manifest-path src-tauri/Cargo.toml",
    "check:all": "bun run lint && bun run typecheck:e2e && bun run check:rust && bun run verify:shell-contracts && bun run check:i18n && bun run verify:version-parity",
    "preview": "vite preview",
    "tauri": "tauri",
    "check:i18n": "node scripts/verify/i18n-keys.mjs",
    "verify:shell-contracts": "node scripts/verify/phase01-shell-contracts.mjs",
    "verify:version-parity": "node scripts/verify/version-parity.mjs",
    "verify:launch-smoke": "node scripts/verify/launch-smoke.mjs",
    "verify:overlay-smoke": "node scripts/verify/overlay-smoke.mjs",
    "e2e:build": "tauri build --debug --no-bundle --features e2e",
    "e2e": "bun run e2e:build && wdio run wdio.conf.ts",
    "e2e:run": "wdio run wdio.conf.ts"
  },
  "trustedDependencies": [
    "esbuild"
  ],
  "overrides": {
    "undici": "^7.29.0",
    "serialize-javascript": "^7.1.0",
    "@puppeteer/browsers": "^3.2.0"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-log": "^2.9.0",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-store": "^2.4.4",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@tauri-apps/plugin-window-state": "^2.4.1",
    "i18next": "^26.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.12"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "@wdio/cli": "^9.31.2",
    "@wdio/globals": "^9.31.1",
    "@wdio/local-runner": "^9.31.2",
    "@wdio/mocha-framework": "^9.31.2",
    "@wdio/spec-reporter": "^9.31.2",
    "@wdio/tauri-service": "^1.3.0",
    "happy-dom": "^20.11.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "webdriverio": "^9.31.2"
  }
}
