{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main settings window. Only the plugin, core and app calls its frontend actually makes, each as an explicit identifier rather than a `:default` set; fs and opener are scoped to the one path and host they serve. Policy and call sites: docs/architecture/ui-and-shell.md, \"Capabilities\".",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-available-monitors",
    "core:window:allow-scale-factor",
    "core:window:allow-inner-size",
    "core:window:allow-outer-size",
    "core:window:allow-outer-position",
    "core:window:allow-is-maximized",
    "core:window:allow-center",
    "core:window:allow-set-position",
    "core:window:allow-set-size",
    "core:window:allow-set-min-size",
    "core:window:allow-show",
    "core:window:allow-unminimize",
    "core:window:allow-set-focus",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "core:webview:allow-internal-toggle-devtools",
    "log:allow-log",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled",
    "dialog:allow-open",
    {
      "identifier": "fs:allow-read-file",
      "allow": [
        {
          "path": "$APPDATA/room-map-backgrounds/*"
        }
      ]
    },
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://lumasync.app/*"
        }
      ]
    },
    "notification:allow-is-permission-granted",
    "process:allow-restart",
    "allow-update-tray-labels",
    "allow-list-serial-ports",
    "allow-connect-serial-port",
    "allow-get-serial-connection-status",
    "allow-run-serial-health-check",
    "allow-discover-hue-bridges",
    "allow-verify-hue-bridge-ip",
    "allow-pair-hue-bridge",
    "allow-validate-hue-credentials",
    "allow-migrate-hue-credentials",
    "allow-list-hue-entertainment-areas",
    "allow-check-hue-stream-readiness",
    "allow-start-hue-stream",
    "allow-apply-outputs",
    "allow-retune-lighting",
    "allow-release-hue-output",
    "allow-get-lighting-runtime",
    "allow-restart-hue-stream",
    "allow-get-hue-health",
    "allow-watch-hue-health",
    "allow-retry-hue-health",
    "allow-get-hue-area-channels",
    "allow-get-runtime-telemetry",
    "allow-show-notification",
    "allow-open-log-dir",
    "allow-get-screen-capture-permission",
    "allow-open-screen-capture-settings",
    "allow-list-displays",
    "allow-open-display-overlay",
    "allow-close-display-overlay",
    "allow-update-display-overlay-preview",
    "allow-copy-background-image",
    "allow-update-hue-channel-positions",
    "allow-create-hue-zone",
    "allow-update-hue-zone",
    "allow-delete-hue-zone",
    "allow-assign-channel-to-hue-zone",
    "allow-simulate-hue-fault",
    "allow-discover-wled-devices",
    "allow-connect-wled-sink",
    "allow-test-wled-bridge",
    "allow-get-wled-sink-status",
    "allow-start-led-test-pattern",
    "allow-stop-led-test-pattern",
    "allow-open-led-twin-overlay",
    "allow-open-led-control-popup",
    "allow-show-led-control-popup",
    "allow-check-for-update",
    "allow-download-and-install-update",
    "allow-get-launch-context",
    "allow-get-shell-state",
    "allow-patch-shell-state",
    "allow-replace-shell-state"
  ]
}
