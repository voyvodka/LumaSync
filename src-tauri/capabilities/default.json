{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main settings window. Only the plugin and core calls its frontend actually makes, each as an explicit identifier rather than a `:default` set; fs and opener are scoped to the one path and host they serve. Policy and call sites: docs/architecture/ui-and-shell.md, \"Capabilities\".",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-available-monitors",
    "core:window:allow-scale-factor",
    "core:window:allow-inner-size",
    "core:window:allow-outer-size",
    "core:window:allow-outer-position",
    "core:window:allow-is-maximized",
    "core:window:allow-center",
    "core:window:allow-set-position",
    "core:window:allow-set-size",
    "core:window:allow-set-min-size",
    "core:window:allow-show",
    "core:window:allow-unminimize",
    "core:window:allow-set-focus",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "core:webview:allow-internal-toggle-devtools",
    "store:allow-load",
    "store:allow-get",
    "store:allow-set",
    "log:allow-log",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled",
    "dialog:allow-open",
    {
      "identifier": "fs:allow-read-file",
      "allow": [{ "path": "$APPDATA/room-map-backgrounds/*" }]
    },
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://lumasync.app/*" }]
    },
    "notification:allow-is-permission-granted",
    "process:allow-restart"
  ]
}
